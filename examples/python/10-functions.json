              { "id": "e", "text": "best = word" },
              { "id": "f", "text": "return best" },
              { "id": "g", "text": "names = [\"Ben\", \"Aoife\", \"Cara\"]" },
              { "id": "h", "text": "print(\"Longest:\", longest(names))" },
              { "id": "d1", "text": "if len(word) > best:" },
              { "id": "d2", "text": "best = 0" },
              { "id": "d3", "text": "print(best)" }
            ]
          },
          "key": {
            "solution": [
              { "id": "a", "indent": 0 },
              { "id": "b", "indent": 1 },
              { "id": "c", "indent": 1 },
