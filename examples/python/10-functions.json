              { "id": "i", "text": "print(\"Total:\", whole)" },
              { "id": "j", "text": "print(\"Average:\", mean)" },
              { "id": "d1", "text": "return total" },
              { "id": "d2", "text": "return average" },
              { "id": "d3", "text": "whole = stats(marks)" }
            ]
          },
          "key": {
            "solution": [
