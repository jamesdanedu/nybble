          "title": "Pick characters out of a word",
          "weight": 1,
          "config": {
            "title": "Pick characters out of a word",
            "instructions": "Positions start at 0, and a negative position counts back from the end. A slice [a:b] takes from a up to but not including b.",
            "language": "python",
            "indentSize": 4,
            "maxIndent": 0,
            "lines": [
              { "id": "a", "text": "word = \"computer\"" },
              { "id": "b", "text": "print(\"First letter:\", word[0])" },
              { "id": "c", "text": "print(\"Last letter:\", word[-1])" },
              { "id": "d", "text": "print(\"First three:\", word[0:3])" },
              { "id": "e", "text": "print(\"From the fourth on:\", word[3:])" }
            ]
          },
          "key": {
            "solution": [
              { "id": "a", "indent": 0 },
              { "id": "b", "indent": 0 },
              { "id": "c", "indent": 0 },
              { "id": "d", "indent": 0 },
              { "id": "e", "indent": 0 }
            ],
            "distractors": [],
            "marks": 5,
            "partial": true,
            "distractorPenalty": 0,
            "explanation": "word[0] is the first character, not the second — counting starts at zero. word[-1] saves you working out the length to reach the end. [0:3] stops before position 3, so it gives three characters, and leaving the second number out means \"carry on to the end\".",
            "check": { "stdout": "First letter: c\nLast letter: r\nFirst three: com\nFrom the fourth on: puter\n" }
          }
        },
