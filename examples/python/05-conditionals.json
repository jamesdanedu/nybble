            "solution": [
              { "id": "a", "indent": 0 },
              { "id": "b", "indent": 0 },
              { "id": "c", "indent": 1 },
              { "id": "d", "indent": 0 },
              { "id": "e", "indent": 1 },
              { "id": "f", "indent": 0 },
              { "id": "g", "indent": 1 }
            ],
            "distractors": [],
            "marks": 7,
            "partial": true,
            "distractorPenalty": 0,
            "explanation": "Python tries the tests from the top and stops at the first one that is true, so the higher threshold has to be asked first. The other way round, a mark of 90 would match >= 30 and be reported as a near miss. if, elif and else all sit at the same indent, because together they are one decision with three branches.",
            "check": { "stdin": "35\n", "stdout": "Mark: Near miss\n" }
