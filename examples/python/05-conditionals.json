              { "id": "b", "text": "if mark >= 40:" },
              { "id": "c", "text": "print(\"Pass\")" },
              { "id": "d", "text": "elif mark >= 30:" },
              { "id": "e", "text": "print(\"Near miss\")" },
              { "id": "f", "text": "else:" },
              { "id": "g", "text": "print(\"Fail\")" }
            ]
