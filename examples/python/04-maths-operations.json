              { "id": "e", "text": "print(\"The average is\", average)" },
              { "id": "f", "text": "print(\"Rounded:\", round(average))" },
              { "id": "d1", "text": "average = first + second + third / 3" },
              { "id": "d2", "text": "average = (first + second + third) // 3" },
              { "id": "d3", "text": "print(\"Rounded:\", round(average, 3))" }
            ]
          },
