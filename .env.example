# ---------------------------------------------------------------------------
# Nybble portal environment
# ---------------------------------------------------------------------------

# Supabase project. Both of these are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The school this deployment logs in to by default. Students type a bare
# username; the portal turns it into <username>@<slug>.portal.invalid before
# calling signInWithPassword. Must match schools.slug exactly.
# A user may still override it by typing username@other-school at the login box.
NEXT_PUBLIC_SCHOOL_SLUG=stmarys

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_. It bypasses RLS.
# Used by the account-admin route handlers (create students, reset passwords)
# and by the activity importer, both of which check is_staff() first.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
